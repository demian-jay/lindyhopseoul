# Frontend. Vite only exposes variables prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:18080

# Local MariaDB development values. Do not reuse these for production.
MARIADB_DATABASE=lindyhopseoul
MARIADB_USER=lindyhop_dev
MARIADB_PASSWORD=lindyhop_dev_password
MARIADB_ROOT_PASSWORD=lindyhop_root_dev_password
MARIADB_PORT=3307

# Backend local profile values. These match the docker-compose defaults above.
SERVER_PORT=18080
DB_URL=jdbc:mariadb://127.0.0.1:3307/lindyhopseoul
DB_USERNAME=lindyhop_dev
DB_PASSWORD=lindyhop_dev_password
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Seed password for the 'admin' account, used only when seeding a brand new
# database. Set this in your local .env. Left blank here on purpose: this file is
# committed, so a value would be a published credential. If unset, the backend
# generates a random password and logs it once at startup.
ADMIN_INITIAL_PASSWORD=

# Google OAuth login. Register the backend callback URI in Google Cloud Console:
# http://localhost:18080/login/oauth2/code/google
GOOGLE_CLIENT_ID=379464115888-9l5qigroaag415hao6nsiurihm6guvd8.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
APP_OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth/success
APP_OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/oauth/error
