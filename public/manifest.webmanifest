{
  "id": "/",
  "name": "SwingPop",
  "short_name": "스윙팝",
  "description": "스윙댄스로 연결되는 커뮤니티, 스윙팝. 일정 확인과 수업 신청을 한곳에서.",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#2e2720",
  "background_color": "#fff3d7",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://swingpopseoul.com/manifest.webmanifest"
    }
  ]
}
